# Copia este archivo como .env y pega la clave creada en Google AI Studio.
# No compartas ni agregues el archivo .env al control de versiones.
GEMINI_API_KEY=your-gemini-api-key

# Estos valores son opcionales. Permiten cambiar de modelo sin modificar código.
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_DAILY_TOKEN_LIMIT=100000

# Durante la transición, 1 conserva el acceso de cuentas antiguas sin perfil institucional.
# Cambia a 0 cuando todas hayan sido regularizadas desde el panel de administración.
ALLOW_LEGACY_USERNAME_LOGIN=1
CELERY_TASK_ALWAYS_EAGER=1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Producción: completa POSTGRES_DB y cambia CELERY_TASK_ALWAYS_EAGER a 0.
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
INSTITUTIONAL_EMAIL_DOMAINS=comunidad.unam.mx

# En desarrollo, los enlaces de recuperación se muestran en la terminal.
# En producción configura un backend SMTP de Django y su remitente.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-responder@doit-unam.local
